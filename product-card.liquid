{% comment %}
  Adjusted by CLEARgo
{% endcomment %}

{%- liquid
  assign products_hover_images = settings.products_hover_images
  assign product_aspect_ratio = settings.product_aspect_ratio
  assign product_content_alignment = settings.product_content_alignment
  assign featured_media = product_card_product.featured_media
  assign product_price_position = settings.product_price_position
  assign ratio = 1
  assign sizes = '298x298,596x596'
  assign info_spacing = true
  assign product_card_border = settings.product_card_border
  assign product_card_shadow = settings.product_card_shadow
  assign product_card_shadow_class = 'has-shadow--' | append: product_card_shadow

  if featured_media.media_type != 'image'
    assign featured_media = featured_media.preview_image
  endif

  if product_aspect_ratio == 'adapt'
    assign ratio = featured_media.aspect_ratio
    assign sizes = '298x0'
  elsif product_aspect_ratio == 'portrait'
    assign ratio = 1 | divided_by: 1.25
    assign sizes = '298x350,596x700'
  elsif product_aspect_ratio == 'landscape'
    assign ratio = 1 | divided_by: 0.75
    assign sizes = '298x250,596x500'
  endif

  assign color_body_bg = settings.color_body_bg | downcase
  assign color_product_card_bg = settings.color_product_card_bg | downcase

  if color_body_bg == color_product_card_bg or color_product_card_bg == 'transparent' or color_product_card_bg == 'rgba(0,0,0,0)'
    unless product_card_border
      assign info_spacing = false
    endunless
    if product_card_shadow
      assign info_spacing = true
    endif
  endif

  assign is_purchasable = false
  if product_card_product.available and product_card_product.variants.size == 1
    assign is_purchasable = true
  endif

  for variant in product_card_product.variants
    if variant.metafields.clearomni.checkout_points_amount
      assign checkout_points_amount = variant.metafields.clearomni.checkout_points_amount
    endif
    if checkout_points_amount
    else
      assign checkout_points_amount = variant.product.metafields.clearomni.checkout_points_amount
    endif
  endfor

  if checkout_points_amount == blank
    assign checkout_points_amount = 0
  endif

  assign randomNumber = 'now' | date: '%N' | modulo: 10000 | plus: 0

  if checkout_points_amount == blank
    assign checkout_points_amount = 0
  endif

  assign img_alert = 'alert.png' | asset_url

  assign group_error = false
  if checkout_points_amount != 0
    if customer
      assign group = customer.metafields.clearomni.customer_group | append: ''
      if group != 'gid://shopify/Metaobject/127492063309' and group != 'gid://shopify/Metaobject/127492096077'
        assign err_msg = 'customer.money_with_point_member_group_err_msg' | t
        assign group_error = true
      else
        assign customer_point = customer.metafields.clearomni.points.value
        if customer_point == blank or customer_point < checkout_points_amount
          assign err_msg = 'customer.money_with_point_no_enough_err_msg' | t
        endif
      endif
    else
      assign err_msg = 'customer.money_with_point_not_login_err_msg' | t
    endif
  endif

  assign msg = "<img src='" | append: img_alert | append: "' /> " | append: err_msg

  assign co_customer_point = 0
  assign co_customer_point_str = customer.metafields.clearomni.points.value
  if co_customer_point_str != ''
    assign co_customer_point = co_customer_point_str | plus: 0
  endif

  assign co_add_to_cart_error = false
  assign co_disabled_class = ''

  if group_error
    assign co_add_to_cart_error = true
    assign co_disabled_class = 'co-disable-addToCart'
  endif

  if checkout_points_amount != blank and checkout_points_amount != 0
    if co_customer_point_str == '' or co_customer_point < checkout_points_amount
      assign co_add_to_cart_error = true
      assign co_disabled_class = 'co-disable-addToCart'
    endif
  endif
-%}

<style>
    div::empty {
      display: none;
    }
    .grid-variant {
    	font-size: .8125rem;
    	font-weight: var(--font-body-medium-weight, 500);
    	margin-bottom: 5px;
    }

    #shopify-section-{{ section.id }} .product-card-info {
   gap: 10px;
    }
    #shopify-section-{{ section.id }} .product-card-title {
  margin: 0;
    }
    #shopify-section-{{ section.id }} .product-card-info .grid-variant {
  margin: 0;
     line-height: normal;
    }
    #shopify-section-{{ section.id }} .product-card{
   margin-bottom: {{ settings.card_bottom_spacing }}px;
    }
    #shopify-section-{{ section.id }} .product-card-title h3 {
    	line-height: normal;
    	font-size: 1rem;
    	font-weight: 500;
    	font-family: -apple-system, BlinkMacSystemFont, avenir next, avenir, segoe ui, helvetica neue, helvetica, Cantarell, Ubuntu, roboto, noto, arial, sans-serif;
  margin: 0;
    	transition: all .3s;
    }

    #shopify-section-{{ section.id }} .product-card-title h3:hover {
    	color: {{ settings.color_gold }};
    }

    #shopify-section-{{ section.id }} .product-card--add-to-cart-button-wrapper .button {
      {% if settings.show_cta_icon == true %}
      {% if settings.quick_add_btn_bg != blank %}
  background: {{ settings.quick_add_btn_bg }};
  height: {{ settings.quick_add_button_width }}px;
      {% endif %}
  {% if settings.quick_add_button_width != 0 %}
    width: {{ settings.quick_add_button_width }}px;
    padding: 10px;
    margin-left: 5px;
    margin-bottom: 5px;
  {% endif %}
{% else %}
    width: 90%;
    margin: 0 auto;
  {% endif %}
    }
    #shopify-section-{{ section.id }} .product-card--add-to-cart-button-wrapper .button .cart-icon svg{
      width: {{ settings.cta_icon_size }}px !important;
      height: {{ settings.cta_icon_size }}px !important;
    }
    #shopify-section-{{ section.id }} .product-card--add-to-cart-button-wrapper .button .cart-icon svg *{
      fill: #ffffff;
    }
    .product-card .product-card-info [id^=add_to_cart_error_msg_]{
      padding-top: 0px !important;
      line-height: normal;
    }
    #add_to_cart_button_parent_{{ randomNumber }}{
      position: absolute;
      {% if settings.show_cta_icon == true %}
        bottom: 0px;
        left: 0;
      {% else %}  
        bottom: 15px;
        left: 15px;
        width: 100%;
      {% endif %}
	  } 
  .product-card .product-card-info .price{
    margin-top: 0;
  }
    @media screen and (max-width: 768px){
  #shopify-section-{{ section.id }} .product-card--add-to-cart-button-wrapper .button .cart-icon svg{
  	width: {{ settings.cta_icon_size_mb }}px !important;
  	height: {{ settings.cta_icon_size_mb }}px !important;
  }
  #shopify-section-{{ section.id }} .product-card--add-to-cart-button-wrapper .button {
      {% if settings.show_cta_icon == true %}
      {% if settings.quick_add_btn_bg != blank %}
  background: {{ settings.quick_add_btn_bg }};
{% endif %}
{% if settings.quick_add_button_width_mb != 0 %}
    height: {{ settings.quick_add_button_width_mb }}px;
    width: {{ settings.quick_add_button_width_mb }}px;
    padding: 10px;
    margin-left: 5px;
    margin-bottom: 5px;
  {% endif %}
{% else %}
    width: 90%;
    margin: 0 auto;
  {% endif %}
    }
    #add_to_cart_button_parent_{{ randomNumber }}{
      position: absolute;
      {% if settings.show_cta_icon == true %}
        bottom: 0px;
        left: 0;
      {% else %}  
        bottom: 9px;
        left: 9px;
        width: 100%;
      {% endif %}
	  } 
    }
</style>

{%- if product_card_product and product_card_product != empty -%}
  <product-card
    data-la-dn-product-handle="{{ product_card_product.handle }}"
    data-la-dn-product-id="{{ product_card_product.id }}"
    data-la-dn-product-collection-handles="{{ product_card_product.collections | map: 'handle' | join: ',' | default: '[[--NONE--]]' }}"
    data-la-dn-product-collection-ids="{{ product_card_product.collections | map: 'id' | join: ',' | default: '[[--NONE--]]' }}"
    data-la-dn-product-available="{{ product_card_product.available}}"
    data-la-dn-product-price="{{ product_card_product.first_available_variant.price | default: product_card_product.price }}"
    data-la-dn-product-compare-at-price="{{ product_card_product.first_available_variant.compare_at_price | default: product_card_product.first_available_variant.price | default: product_card_product.compare_at_price | default: product_card_product.price }}"
    data-la-dn-product-price-varies="{{ product_card_product.price_varies }}"
    data-la-dn-product-compare-at-price-varies="{{ product_card_product.compare_at_price_varies }}"
    data-la-dn-product-price-min="{{ product_card_product.price_min }}"
    data-la-dn-product-tags="{{ product_card_product.tags | join: ',' | escape | default: '[[--NONE--]]' }}"

    class="product-card text-{{ product_content_alignment }} product-card--content-spacing-{{ info_spacing }} product-card--border-{{ product_card_border }} {{ product_card_shadow_class }}"
  >
    {% if co_add_to_cart_error %}
      <div id="add_to_cart_error_msg_div_{{ randomNumber }}" style="display:none">{{ msg }}</div>
    {% endif %}

    <figure class="la-dn-collection-badge product-featured-image {% if products_hover_images and product_card_product.images.size > 1 %}thb-hover{% endif %}">
      {% render 'product-card-badge', product_card_product: product_card_product %}
      <a
        href="{{ product_card_product.url | within: collection }}"
        title="{{ product_card_product.title | escape }}"
        class="product-featured-image-link aspect-ratio aspect-ratio--{{ settings.product_aspect_ratio }}"
        style="--padding-bottom: {{ 1 | divided_by: ratio | times: 100 }}%;"
      >
        {%- if products_hover_images and product_card_product.images.size > 1 -%}
          {%- render 'responsive-image',
            class: 'product-secondary-image',
            image: product_card_product.images[1],
            sizes: sizes
          -%}
        {%- endif -%}
        {%- if featured_media -%}
          {%- render 'responsive-image', class: 'product-primary-image', image: featured_media, sizes: sizes -%}
        {%- else -%}
          <div class="thb-placeholder">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {%- endif -%}

        {%- if settings.enable_quick_view -%}
          <quick-view
            class="product-card-quickview"
            data-product-handle="{{ product_card_product.handle }}"
            tabindex="-1"
          >
            <div class="loading-overlay">{% render 'svg-icons' with 'thb-loading' %}</div>
            {%- render 'svg-icons' with 'quick-eye' -%}
            <span>{{ 'products.product.quick_view' | t }}</span>
          </quick-view>
        {%- endif -%}
      </a>

      <!-- product-card-quick-add -->
      {%- if settings.enable_quick_add -%}
        {%- liquid
          assign button_tag = 'button'
          if product_card_product.selected_or_first_available_variant.available == false
            assign button_content = 'products.product.sold_out' | t
          else
            if product_card_product.metafields.theme.preorder and product_card_product.available
              assign button_content = 'products.product.pre_order' | t
            else
              if is_purchasable
                if product_card_product.metafields.clearomni.checkout_points_amount != blank
                  assign button_content = 'products.product.redeem_now' | t
                else
                  assign button_content = 'products.product.add_to_cart' | t
                endif
              else
                assign button_tag = 'quick-view'
                assign button_content = 'products.product.choose_options' | t
              endif
            endif
          endif
        -%}
        <div class="atcqa" id="add_to_cart_button_parent_{{ randomNumber }}">
          <div class="product-card--add-to-cart-button-wrapper">
            <{{ button_tag }}
              class="{{ co_disabled_class }} product-card--add-to-cart-button{% if is_purchasable %} product-card--add-to-cart-button-simple{% endif %} button accent"
              data-product-id="{{ product_card_product.selected_or_first_available_variant.id }}"
              data-product-handle="{{ product_card_product.handle }}"
              data-rand="{{ randomNumber }}"
              tabindex="-1"
              {% if product_card_product.selected_or_first_available_variant.available == false %}
                disabled
              {% endif %}
            >
              {% render 'svg-icons' with 'thb-loading' %}
              {% if settings.show_cta_icon == true %}
                {% if product_card_product.metafields.clearomni.checkout_points_amount != blank %}
                  <span class="cart-icon">
                    {% if settings.quick_add_redemption_icon_code != blank %}
                      {{ settings.quick_add_redemption_icon_code }}
                    {% else %}
                      {{ 'icon-cart-redemption.svg' | inline_asset_content }}
                    {% endif %}
                  </span>
                  {% comment %}Icon cart for the products with redemption{% endcomment %}
                {% else %}
                  <span class="cart-icon">
                    {% if settings.quick_add_icon_code != blank %}
                      {{ settings.quick_add_icon_code }}
                    {% else %}
                      {{ 'icon-cart.svg' | inline_asset_content }}
                    {% endif %}
                  </span>
                  {% comment %}Icon cart for the products without redemption{% endcomment %}
                {% endif %}
              {% endif %}
              {% if settings.show_cta_icon == false %}
                <span class="product-card--add-to-cart-text">{{ button_content }}</span>
              {% endif %}
            </{{ button_tag }}>
          </div>
          {% comment %}
            {% if product_card_product.metafields.clearomni.checkout_points_amount != blank %}
                     <div class="redemption_text_container">
              <span class="redemption_text">
            	{{ product_card_product.metafields.clearomni.checkout_points_amount }}+ Exclusive: Redemption
              </span>
            </div>
                   {% endif %}
          {% endcomment %}
        </div>
      {%- endif -%}
    </figure>
    <div class="product-card-info">
      {%- if settings.show_products_vendor -%}
        <div class="product-card-vendor">
          <a
            href="{{ product_card_product.vendor | url_for_vendor }}"
            title="{{ product_card_product.vendor | escape }}"
          >
            {{- product_card_product.vendor -}}
          </a>
        </div>
      {%- endif -%}
      {%- liquid
        if product_price_position == 'before-product-title'
          render 'product-price', product: product_card_product
        endif
      -%}
      <a
        href="{{ product_card_product.url | within: collection }}"
        title="{{ product_card_product.title | escape }}"
        class="product-card-title"
      >
        <h3>{{ product_card_product.title }}</h3>
      </a>
      {% if product_card_product.options.size > 0 and product_card_product.options contains 'Packaging' %}
        <div class="grid-variant">
          {% if product_card_product.options contains 'Packaging' %}
            {% for option in product_card_product.options_with_values %}
              {% for value in option.values %}
                {% if forloop.index == 1 %}
                  {% comment %}
                    {{ value | replace: '/ hk', '' | replace: ' hk', '' }}
                  {% endcomment %}
                  {{ value | remove: 'hk' }}
                {% endif %}
              {% endfor %}
            {% endfor %}
          {% endif %}
        </div>
      {% endif %}
      <span data-la-dn-price>
        {%- liquid
          if product_price_position == 'after-product-title'
            render 'product-price', product: product_card_product
          endif
        -%}
      </span>
      {% render 'product-card-swatch', product: product_card_product, sizes: sizes %}
      {%- if settings.show_products_rating and product_card_product.metafields.reviews.rating.value != blank -%}
        <div
          class="star-rating"
          style="--star-rating: {{ product_card_product.metafields.reviews.rating.value.rating }};"
        >
          {%- if settings.show_products_rating_average -%}
            <span class="body-font">{{ product_card_product.metafields.reviews.rating.value.rating | round: 2 }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
      {%- render 'product-card-inventory-notice', product: product_card_product -%}
      {%- render 'product-card-labels', product: product_card_product -%}
      {%- if settings.show_products_subtitle and product_card_product.metafields.descriptors.subtitle != blank -%}
        <p class="product-card-subtitle">{{ product_card_product.metafields.descriptors.subtitle }}</p>
      {%- endif -%}
      {% if co_add_to_cart_error %}
        <div id="add_to_cart_error_msg_{{ randomNumber }}">
          <br>
          <br>
        </div>
      {% endif %}
    </div>
  </product-card>
{%- else -%}
  <product-card class="product-card text-{{ product_content_alignment }} product-card--content-spacing-{{ info_spacing }} product-card--border-{{ product_card_border }} {{ product_card_shadow_class }}">
    <figure class="product-featured-image {% if settings.products_hover_images %}thb-hover{% endif %}">
      <a
        href="{{ product_card_product.url | within: collection }}"
        title="{{ product_card_product.title | escape }}"
        class="product-featured-image-link aspect-ratio aspect-ratio--{{ settings.product_aspect_ratio }}"
        style="--padding-bottom: {{ 1 | divided_by: 1 | times: 100 }}%;"
      >
        <div class="thb-placeholder">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
        <quick-view
          class="product-card-quickview"
          data-product-handle="{{ product_card_product.handle }}"
          tabindex="-1"
        >
          <div class="loading-overlay">{% render 'svg-icons' with 'thb-loading' %}</div>
          <span>{{ 'products.product.quick_view' | t }}</span>
        </quick-view>
      </a>
    </figure>
    <div class="product-card-info">
      <div class="product-card-vendor">
        <a href="#" title="{{ 'onboarding.product_vendor' | t }}">{{ 'onboarding.product_vendor' | t }}</a>
      </div>
      {%- liquid
        if product_price_position == 'before-product-title'
          render 'product-price', product: product_card_product
        endif
      -%}
      <a href="#" title="{{ product_card_product.title | escape }}" class="product-card-title">
        <h3>{{ 'onboarding.product_title' | t }}</h3>
      </a>
      {% if product_card_product.options.size > 0 %}
        <div class="grid-variant">
          {% if product_card_product.options contains 'Packaging' %}
            {% for option in product_card_product.options_with_values %}
              {% for value in option.values %}
                {% if forloop.index == 1 %}
                  {{ value | replace: '/ hk', '' | replace: 'hk', '' }}
                {% endif %}
              {% endfor %}
            {% endfor %}
          {% endif %}
        </div>
      {% endif %}
      {%- liquid
        if product_price_position == 'after-product-title'
          render 'product-price', product: product_card_product
        endif
      -%}
      {%- if settings.show_products_rating and product_card_product.metafields.reviews.rating.value != blank -%}
        <div class="star-rating" style="--star-rating: 5;"><span class="body-font">5</span></div>
      {%- endif -%}
      {%- if settings.enable_quick_add -%}
        <div class="product-card--add-to-cart-button-wrapper">
          <quick-view class="product-card--add-to-cart-button button accent" data-product-handle="" tabindex="-1">
            {% render 'svg-icons' with 'thb-loading' %}
            <span class="product-card--add-to-cart-text">{{ 'products.product.choose_options' | t }}</span>
          </quick-view>
        </div>
      {%- endif -%}
    </div>
  </product-card>
{%- endif -%}