<!-- Section File Name: category-tabs-products.liquid -->
<!-- Section Name: Category Tabs + Products -->

<!-- Swiper CDN -->
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />

<div id="sid-{{ section.id }}" class="cat-tabs-section">
  <div class="cat-tabs-wrapper">

    {%- if section.settings.heading != blank -%}
      <h2 class="cat-tabs-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="cat-tabs-menu-scroll">
      <ul class="cat-tabs-menu" role="tablist">
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_active = false
            if block.settings.default_active and default_set != true
              assign is_active = true
              assign default_set = true
            endif
            if forloop.first and default_set != true
              assign is_active = true
              assign default_set = true
            endif
          -%}
          <li class="cat-tab-item{% if is_active %} active{% endif %}"
              data-tab-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}>
            {{ block.settings.label }}
          </li>
        {%- endfor -%}
      </ul>
    </div>

    {%- for block in section.blocks -%}
      {%- liquid
        assign panel_active = false
        if block.settings.default_active and panel_default_set != true
          assign panel_active = true
          assign panel_default_set = true
        endif
        if forloop.first and panel_default_set != true
          assign panel_active = true
          assign panel_default_set = true
        endif

        # ---------------------------------------------------------------
        # WHAT THIS TAB SHOWS  (decided by the BLOCK TYPE, not by counting)
        #   tab_products        : 1 collection  -> that collection's products
        #   tab_collection_list : 1+ collections -> collection cards
        #   tab                 : legacy block type, kept so sections saved
        #                         before these two types keep working the old
        #                         way (1 collection = products, 2+ = cards)
        # ---------------------------------------------------------------
        assign tab_list = block.settings.collections
        assign tab_list_size = tab_list.size | default: 0
        assign tab_single = blank
        assign tab_mode = 'none'

        if block.type == 'tab_products'
          assign tab_mode = 'products'
          assign tab_single = block.settings.collection
        elsif block.type == 'tab_collection_list'
          if tab_list_size > 0
            assign tab_mode = 'cards'
          endif
        elsif block.type == 'tab'
          if tab_list_size == 1
            assign tab_mode = 'products'
            for collection in tab_list limit: 1
              assign tab_single = collection
            endfor
          elsif tab_list_size > 1
            assign tab_mode = 'cards'
          endif
        endif

        # Per-tab show/hide of collection names. Defaults to ON so old
        # sections keep behaving exactly as before.
        assign show_names = block.settings.show_collection_names
        if show_names == nil
          assign show_names = true
        endif

        # Global fallback: if the section-wide "Hide collection names on cards"
        # is ON, names stay hidden even when a tab says "show".
        if section.settings.hide_collection_names
          assign show_names = false
        endif
      -%}
      <div class="cat-tab-panel{% if panel_active %} active{% endif %}" data-panel-index="{{ forloop.index0 }}">

        {%- if tab_mode == 'products' -%}

          {% assign tab_collection = tab_single %}
          {%- comment -%}
            nil-safe "is a collection really selected?" test — comparing against
            blank behaves differently across Liquid engines, while a real
            Shopify collection always has a title.
          {%- endcomment -%}
          {% assign tab_collection_title = tab_collection.title | default: '' %}

          {% if tab_collection_title != '' %}
            {%- comment -%}
              Products come straight from the collection selected in this block.
              collections[handle] is only a fallback — it returns nil when the
              collection is not published to the Online Store / this market.
            {%- endcomment -%}
            {% assign tab_products = tab_collection.products %}
            {% assign tab_products_count = tab_products.size | default: 0 %}
            {% if tab_products_count == 0 %}
              {% assign tab_products = collections[tab_collection.handle].products %}
              {% assign tab_products_count = tab_products.size | default: 0 %}
            {% endif %}

            <div class="swiper-container-{{ section.id }}-{{ forloop.index0 }} swiper-container-mobile">
              <ul class="product-grid-list swiper-wrapper">

                {% assign count = 0 %}

                {% if tab_products_count > 0 %}

                  {%- comment -%}
                    In-stock products first, up to "Products per tab".
                  {%- endcomment -%}
                  {% for product in tab_products %}
                    {% if product.available %}
                      {% assign count = count | plus: 1 %}
                      <li class="column swiper-slide">
                        {% render 'product-card', product_card_product: product %}
                      </li>

                      {% if count >= section.settings.products_limit %}
                        {% break %}
                      {% endif %}
                    {% endif %}
                  {% endfor %}

                  {%- comment -%}
                    Fill the leftover slots with the collection's sold-out products,
                    so a collection with only 1 in-stock product still fills the tab
                    instead of showing a single card. The theme's product card
                    shows the "Sold out" state for these.
                  {%- endcomment -%}
                  {% if count < section.settings.products_limit %}
                    {% assign fsb_so_slots = section.settings.products_limit | minus: count %}
                    {% assign fsb_so_added = 0 %}
                    {% for product in tab_products %}
                      {% unless product.available %}
                        {% if fsb_so_added >= fsb_so_slots %}
                          {% break %}
                        {% endif %}
                        {% assign fsb_so_added = fsb_so_added | plus: 1 %}
                        <li class="column swiper-slide">
                          {% render 'product-card', product_card_product: product %}
                        </li>
                      {% endunless %}
                    {% endfor %}
                  {% endif %}

                {% else %}

                  <li class="cat-tab-empty">
                    No products found in "{{ tab_collection.title }}".

                    <small>This collection has no published products — check that its products are available on the Online Store sales channel for this market.</small>
                  </li>

                {% endif %}

              </ul>
              <div class="swiper-pagination-{{ section.id }}-{{ forloop.index0 }}"></div>
            </div>
          {% else %}
            <p class="cat-tab-empty">No collection selected.</p>
          {% endif %}

        {%- elsif tab_mode == 'cards' -%}

          {%- comment -%}
            FEATURED (BIG) COLLECTION CARDS
            Up to two collections picked in this block (Featured collection 1 / 2)
            are shown as large cards in front of the 2x2 groups of four - same
            design language as the small cards, only bigger. Badge + caption are
            optional. The groups below stay exactly as they were.
          {%- endcomment -%}
          {%- assign fsb_feat_1 = block.settings.featured_1 -%}
          {%- assign fsb_feat_2 = block.settings.featured_2 -%}

          <div class="cat-collection-groups{% unless show_names %} cat-hide-names{% endunless %}" style="--cat-collection-groups-cols: {{ section.settings.collection_columns_desktop }};">
            {%- for fsb_slot in (1..2) -%}
              {%- liquid
                if fsb_slot == 1
                  assign fsb_fc = fsb_feat_1
                  assign fsb_fc_badge = block.settings.featured_1_badge
                  assign fsb_fc_caption = block.settings.featured_1_caption
                else
                  assign fsb_fc = fsb_feat_2
                  assign fsb_fc_badge = block.settings.featured_2_badge
                  assign fsb_fc_caption = block.settings.featured_2_caption
                endif
                assign fsb_fc_title = fsb_fc.title | default: ''
              -%}
              {%- if fsb_fc_title != '' -%}
                <a href="{{ fsb_fc.url }}" class="cat-collection-featured">
                  <span class="cat-collection-featured-media">
                    {%- if fsb_fc.featured_image -%}
                      {{ fsb_fc.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: fsb_fc.title }}
                    {%- elsif fsb_fc.products.first.featured_image -%}
                      {{ fsb_fc.products.first.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: fsb_fc.title }}
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'cat-collection-placeholder' }}
                    {%- endif -%}
                  </span>
                 
                  <span class="cat-collection-featured-body">
                    <span class="cat-collection-featured-title">{{ fsb_fc.title }}</span>
                  </span>
    
                </a>
              {%- endif -%}
            {%- endfor -%}
            {%- assign group_size = 4 -%}
            {%- for tab_collection in tab_list -%}
              {%- assign idx0 = forloop.index0 -%}
              {%- assign mod = idx0 | modulo: group_size -%}
              {%- if mod == 0 -%}
                {%- unless forloop.first -%}</div>{%- endunless -%}
                <div class="cat-collection-group">
              {%- endif -%}

              <a href="{{ tab_collection.url }}" class="cat-collection-card">
                <span class="cat-collection-card-image">
                  {%- if tab_collection.featured_image -%}
                    {{ tab_collection.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: tab_collection.title }}
                  {%- elsif tab_collection.products.first.featured_image -%}
                    {{ tab_collection.products.first.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: tab_collection.title }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'cat-collection-placeholder' }}
                  {%- endif -%}
                </span>
                <span class="cat-collection-card-title">{{ tab_collection.title }}</span>
              </a>

              {%- if forloop.last -%}</div>{%- endif -%}
            {%- endfor -%}
          </div>

        {%- else -%}

          <p class="cat-tab-empty">Please select at least one collection for this tab in theme editor.</p>

        {%- endif -%}

        {%- comment -%}
          BIG COLLECTIONS ROW (bottom) - gallery-style: up to THREE collections
          picked in this block are shown as ONE row of big image cards BELOW
          the tab's products / collection cards. Tabs where no big collection
          is picked render nothing here.
        {%- endcomment -%}
        {%- assign cat_big_1_t = block.settings.big_1.title | default: '' -%}
        {%- assign cat_big_2_t = block.settings.big_2.title | default: '' -%}
        {%- assign cat_big_3_t = block.settings.big_3.title | default: '' -%}
        {%- if cat_big_1_t != '' or cat_big_2_t != '' or cat_big_3_t != '' -%}
          <div class="cat-big-row">
            {%- for cat_big_slot in (1..3) -%}
              {%- liquid
                if cat_big_slot == 1
                  assign cat_bc = block.settings.big_1
                elsif cat_big_slot == 2
                  assign cat_bc = block.settings.big_2
                else
                  assign cat_bc = block.settings.big_3
                endif
                assign cat_bc_title = cat_bc.title | default: ''
              -%}
              {%- if cat_bc_title != '' -%}
                <a href="{{ cat_bc.url }}" class="cat-big-card">
                  <span class="cat-big-card-media">
                    {%- if cat_bc.featured_image -%}
                      {{ cat_bc.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: cat_bc.title }}
                    {%- elsif cat_bc.products.first.featured_image -%}
                      {{ cat_bc.products.first.featured_image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: cat_bc.title }}
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'cat-collection-placeholder' }}
                    {%- endif -%}
                  </span>
                  <span class="cat-big-card-title">{{ cat_bc.title }}</span>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

      </div>
    {%- endfor -%}

  </div>
</div>

<style>
  #sid-{{ section.id }} {
    padding:
      {{ section.settings.section_padding_top }}px
      {{ section.settings.section_padding_right }}px
      {{ section.settings.section_padding_bottom }}px
      {{ section.settings.section_padding_left }}px;
  }
  #sid-{{ section.id }} .cat-tabs-wrapper{
    max-width: {{ section.settings.maxWidth }}px;
    margin: 0 auto;
  }
  #sid-{{ section.id }} .cat-tabs-heading{
    text-align: center;
    margin-bottom: 20px;
    font-size: 24px;
  }

  /* Menu / pills */
  #sid-{{ section.id }} .cat-tabs-menu-scroll{
    width: 100%;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  #sid-{{ section.id }} .cat-tabs-menu-scroll::-webkit-scrollbar{ display:none; }

  /* FIX: the pills row now carries the same 40px left/right inset as the
     product grid below it, so the pills never stick to the sidebar drawer
     edge when the drawer is open and the visible area gets narrow.
     width: max-content + min-width: 100% keeps the padding intact while
     scrolling, and keeps the centered layout safe (no clipped left side)
     when the pills overflow. */
  #sid-{{ section.id }} .cat-tabs-menu{
    display: flex;
    justify-content: {% if section.settings.center_menu %}center{% else %}flex-start{% endif %};
    gap: {{ section.settings.pill_gap }}px;
    list-style: none;
    margin: 0 0 30px;
    padding: 0 40px;
    flex-wrap: nowrap;
    box-sizing: border-box;
    width: max-content;
    min-width: 100%;
  }

  #sid-{{ section.id }} .cat-tab-item{
    flex: 0 0 auto;
    white-space: nowrap;
    cursor: pointer;
    scroll-snap-align: start;
    padding: {{ section.settings.pill_padding_v }}px {{ section.settings.pill_padding_h }}px;
    border-radius: {{ section.settings.pill_radius }}px;
    border: 1px solid {{ section.settings.pill_border_color }};
    background: {{ section.settings.pill_bg }};
    color: {{ section.settings.pill_text_color }};
    font-size: {{ section.settings.pill_font_size }}px;
    font-weight: {{ section.settings.pill_font_weight }};
    transition: all 0.2s ease;
  }
  #sid-{{ section.id }} .cat-tab-item.active{
    background: {{ section.settings.pill_active_bg }};
    color: {{ section.settings.pill_active_text_color }};
    border-color: {{ section.settings.pill_active_bg }};
  }
  /* FIX: scroll-snap (align: start) was snapping the first pill to the very
     edge of the scroller whenever the row overflowed (e.g. when the sidebar
     drawer is open), which scrolled the left padding away - so pills looked
     glued to the drawer. Snap is off on desktop/tablet, and scroll-padding
     keeps the inset even if the row is scrolled. */
  #sid-{{ section.id }} .cat-tabs-menu-scroll{
    scroll-snap-type: none;
    scroll-padding-left: 40px;
    scroll-padding-right: 40px;
  }

  /* Panels / grid */
  #sid-{{ section.id }} .cat-tab-panel {
    display: none;
  }

  #sid-{{ section.id }} .cat-tab-panel.active{
    display: block;
    padding-left: 0px;
  }

  #sid-{{ section.id }} .product-grid-list .column,
  #sid-{{ section.id }} .cat-collection-group .cat-collection-card {
    opacity: 0;
    transform: translateY(20px);
  }

  #sid-{{ section.id }} .cat-tab-panel.active .product-grid-list .column,
  #sid-{{ section.id }} .cat-tab-panel.active .cat-collection-group .cat-collection-card {
    animation: catTabFadeIn 0.6s ease forwards;
    padding-left: 0;
  }

  @keyframes catTabFadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  {%- for i in (1..12) -%}
  #sid-{{ section.id }} .cat-tab-panel.active .product-grid-list .column:nth-child({{ i }}){
    animation-delay: {{ i | times: 0.06 }}s;
  }
  {%- endfor -%}

  #sid-{{ section.id }} .product-grid-list{
    display: grid;
    grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
    gap: {{ section.settings.grid_gap }}px;
    list-style: none;
    margin: 0;
    padding: 0 0px 0px 40px;
  }
  #sid-{{ section.id }} .product-grid-list .column{ list-style: none; }
  #sid-{{ section.id }} .cat-tab-empty{
    grid-column: 1 / -1;
    text-align: center;
    color: #888;
    padding: 40px 0;
  }

  #sid-{{ section.id }} .product-card-info {
    text-align: center;
  }

  /* Product card title + variant line colors (theme editor -> "Product Card
     Colors"). Scoped to THIS section's cards only - the theme's product grid
     on collection pages is not touched. The defaults are the store's current
     colors (#3a3e46) - nothing changes until a new color is picked. The
     theme's gold hover effect on the title still wins. */
  #sid-{{ section.id }} .product-card-title h3{
    color: {{ section.settings.product_title_color }};
  }
  #sid-{{ section.id }} .grid-variant{
    color: {{ section.settings.product_variant_color }};
  }

  /* Collection cards (shown when a tab has multiple collections selected) */
  /* Groups: every 4 collections form a 2x2 block, blocks sit side by side */
  #sid-{{ section.id }} .cat-collection-groups{
    display: grid;
    grid-template-columns: repeat(var(--cat-collection-groups-cols, 4), 1fr);
    gap: 20px;
    padding: 0 0 0 40px;
  }
  #sid-{{ section.id }} .cat-collection-group{
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 1fr;
    gap: 10px;
  }
  #sid-{{ section.id }} .cat-collection-card{
    position: relative;
    display: block;
    width: 100%;
    height:fit-content;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background: #e9e9e9;

  }
  #sid-{{ section.id }} .cat-collection-card-image{
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }
  #sid-{{ section.id }} .cat-collection-card-image img,
  #sid-{{ section.id }} .cat-collection-card-image .cat-collection-placeholder{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #sid-{{ section.id }} .cat-collection-card::after{
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.6), rgba(0,0,0,0) 55%);
    pointer-events: none;
  }
  #sid-{{ section.id }} .cat-collection-card-title{
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 12px;
    z-index: 2;
    color: #ffffff;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.2;
  }

  /* Featured (big) collection card - one grid cell, same footprint as a 2x2
     group of four small cards, so a "bigger" collection shows next to the
     groups without moving anything else. */
  #sid-{{ section.id }} .cat-collection-featured{
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    aspect-ratio: 1 / 1;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: #ffffff;
    background: #e9e9e9;
    padding: 20px 18px 22px;
    box-sizing: border-box;
  }
  #sid-{{ section.id }} .cat-collection-featured-media{
    position: absolute;
    inset: 0;
    display: block;
  }
  #sid-{{ section.id }} .cat-collection-featured-media img,
  #sid-{{ section.id }} .cat-collection-featured-media .cat-collection-placeholder{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  #sid-{{ section.id }} .cat-collection-featured:hover .cat-collection-featured-media img{
    transform: scale(1.04);
  }
  #sid-{{ section.id }} .cat-collection-featured::after{
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0.18) 60%, rgba(0, 0, 0, 0.06));
    pointer-events: none;
  }
  #sid-{{ section.id }} .cat-collection-featured-badge{
    position: relative;
    z-index: 2;
    margin-bottom: auto;              /* sits at the top of the card */
    background: {{ section.settings.featured_badge_color }};
    color: #ffffff;
    font-size: {{ section.settings.featured_badge_font_size }}px;
    font-weight: 600;
    line-height: 1;
    padding: 8px 17px;
    border-radius: 999px;
    white-space: nowrap;
  }
  #sid-{{ section.id }} .cat-collection-featured-body{
    position: relative;
    z-index: 2;
    margin: auto 0;                   /* the title block stays centred */
    display: block;
    align-self: stretch;              /* spans the whole card width, so a long
                                         title only wraps when it really has to */
  }
  #sid-{{ section.id }} .cat-collection-featured-title{
    display: block;
    font-size: {{ section.settings.featured_title_size }}px;
    font-weight: 400;
    line-height: 1.15;
    letter-spacing: 0.2px;
  }
  #sid-{{ section.id }} .cat-collection-featured-caption{
    display: block;
    margin-top: 10px;
    font-size: {{ section.settings.featured_caption_size }}px;
    line-height: 1.45;
    opacity: 0.95;
  }

  {%- if section.settings.hide_collection_names -%}
  /* Hide collection names on small cards + featured (big) cards.
     The Big Collections Row at the bottom uses .cat-big-card and is NOT affected. */
  #sid-{{ section.id }} .cat-collection-card::after{
    display: none;
  }
  #sid-{{ section.id }} .cat-collection-card-title{
    display: none;
  }
  #sid-{{ section.id }} .cat-collection-featured::after{
    display: none;
  }
  #sid-{{ section.id }} .cat-collection-featured-body{
    display: none;
  }
  {%- endif -%}

  /* Per-tab hide (when a single tab has "Show collection names" unchecked).
     Scoped to the wrapper that carries .cat-hide-names, so only that tab is
     affected - the rest of the section keeps names as set. */
  #sid-{{ section.id }} .cat-collection-groups.cat-hide-names .cat-collection-card::after{
    display: none;
  }
  #sid-{{ section.id }} .cat-collection-groups.cat-hide-names .cat-collection-card-title{
    display: none;
  }
  #sid-{{ section.id }} .cat-collection-groups.cat-hide-names .cat-collection-featured::after{
    display: none;
  }
  #sid-{{ section.id }} .cat-collection-groups.cat-hide-names .cat-collection-featured-body{
    display: none;
  }

  /* BIG COLLECTIONS ROW (bottom) - up to 3 collections in ONE line, shown
     BELOW this tab's collection cards / product cards (gallery-style big
     tiles). Empty in every tab where no big collection is picked. */
  #sid-{{ section.id }} .cat-big-row{
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 30px;
    /* aligned edge-to-edge with the cards above: they carry the section's
       40px left inset and run flush to the right - the row uses the exact
       same footprint, so the whole tab is one clean aligned block */
    padding-left: 40px;
    padding-right: 0;
  }
  #sid-{{ section.id }} .cat-big-card{
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    /* wide rectangle by default - the editor setting is back ("Big row
       image ratio"), under a NEW id (big_ratio2) so a stale "Square" value
       saved by an earlier install cannot override the Wide default */
    aspect-ratio: {{ section.settings.big_ratio2 | default: '2 / 1' }};
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: #ffffff;
    background: #e9e9e9;
  }
  #sid-{{ section.id }} .cat-big-card-media{
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
  }
  #sid-{{ section.id }} .cat-big-card-media img,
  #sid-{{ section.id }} .cat-big-card-media .cat-collection-placeholder{
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }
  #sid-{{ section.id }} .cat-big-card:hover .cat-big-card-media img{
    transform: scale(1.04);
  }
  #sid-{{ section.id }} .cat-big-card::after{
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.6), rgba(0,0,0,0) 55%);
    pointer-events: none;
  }
