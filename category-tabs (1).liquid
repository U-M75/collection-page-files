<script>
  (function(){
    var root = document.getElementById('sid-{{ section.id }}');
    if (!root) return;

    var tabs = root.querySelectorAll('.cat-tab-item');
    var panels = root.querySelectorAll('.cat-tab-panel');
    var swipers = {};

    function initSwiper(panelIndex) {
      var containerEl = root.querySelector('.swiper-container-{{ section.id }}-' + panelIndex);
      if (!containerEl || swipers[panelIndex]) return;

      if (window.innerWidth <= 767) {
        // If Swiper failed to load (CDN blocked), keep native scroll fallback
        if (typeof Swiper === 'undefined') {
          containerEl.classList.add('cat-swiper-fallback');
          return;
        }
        containerEl.classList.remove('cat-swiper-fallback');

        swipers[panelIndex] = new Swiper(containerEl, {
          slidesPerView: {{ section.settings.columns_mobile }},
          /* FIX: centeredSlides OFF -> the first card starts at the left on load and
             all {{ section.settings.columns_mobile }} cards are fully visible
             (the old "one centred card with half cards on both sides" problem
             is gone). */
          centeredSlides: false,
          slidesPerGroup: 1,
          spaceBetween: {{ section.settings.grid_gap_mb }},
          loop: false,
          grabCursor: true,
          watchOverflow: true,
          touchRatio: 1,
          touchAngle: 45,
          speed: 400
        });
      }
    }

    function destroySwiper(panelIndex) {
      if (swipers[panelIndex]) {
        swipers[panelIndex].destroy();
        swipers[panelIndex] = null;
      }
      var containerEl = root.querySelector('.swiper-container-{{ section.id }}-' + panelIndex);
      if (containerEl) {
        containerEl.classList.remove('cat-swiper-fallback');
      }
    }

    /* ----------------------------------------------------------------
       Two behaviours in one section:

       CLASSIC (homepage and any normal placement) - exactly as before:
       the first tab is active on load, click switches, content always
       visible.

       BANNER (collection pages) - the "Template header" section renders
       the slot ".th-hero-cattabs-slot-..." and moves this section into
       the collection banner. There the section shows ONLY the tab pills
       by default; hovering a tab (desktop) or tapping it (mobile) opens
       that tab's collection/products as a sheet under the bar; tapping
       the open tab closes it; leaving the tabs block closes it; and the
       bar pins itself directly under the banner's fixed search bar
       (".th-hero-search-wrapper.is-scroll-fixed") while scrolling.

       NOTE: banner mode is currently DISABLED (see boot() below) - the
       section always runs in classic mode, same as the homepage.
       ---------------------------------------------------------------- */
    var BANNER = false;
    var bar = root.querySelector('.cat-tabs-menu-scroll');

    function wireClassic(){
      tabs.forEach(function(tab, idx){
        tab.addEventListener('click', function(){
          var idx = tab.getAttribute('data-tab-index');

          tabs.forEach(function(t){ t.classList.remove('active'); });
          panels.forEach(function(p){ p.classList.remove('active'); });

          tab.classList.add('active');
          var panel = root.querySelector('.cat-tab-panel[data-panel-index="' + idx + '"]');
          if (panel) {
              panel.classList.add('active');

              // Destroy old swipers
              Object.keys(swipers).forEach(function(key) {
                if (key !== idx) {
                  destroySwiper(key);
                }
              });

              // Initialize swiper for active panel
              setTimeout(function() {
                initSwiper(idx);
              }, 50);

              tab.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
          }
        });
      });

      // Initialize swiper for first active panel on load
      panels.forEach(function(panel, idx) {
        if (panel.classList.contains('active')) {
          setTimeout(function() {
            initSwiper(idx);
          }, 100);
        }
      });

      // Re-initialize swiper on resize
      var resizeTimer;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function() {
          if (window.innerWidth <= 767) {
            var activePanel = root.querySelector('.cat-tab-panel.active');
            if (activePanel) {
              var activePanelIdx = activePanel.getAttribute('data-panel-index');
              destroySwiper(activePanelIdx);
              initSwiper(activePanelIdx);
            }
          } else {
            Object.keys(swipers).forEach(function(key) {
              destroySwiper(key);
            });
          }
        }, 250);
      });
    }

    /* ---- banner mode (currently unused - kept for reference) ---- */
    var openIdx = null;
    var hideTimer = null;
    var catLastTouch = 0;
    document.addEventListener('touchstart', function(){ catLastTouch = Date.now(); }, { passive: true, capture: true });

    function bannerOpen(idx){
      if (openIdx === idx) return;
      openIdx = idx;
      tabs.forEach(function(t){ t.classList.remove('active'); });
      panels.forEach(function(p){ p.classList.remove('active'); });
      tabs[idx].classList.add('active');
      var panel = panels[idx];
      panel.classList.add('active');
      Object.keys(swipers).forEach(function(key) {
        if (key !== String(idx)) destroySwiper(key);
      });
      setTimeout(function() { initSwiper(idx); }, 50);
    }

    function bannerClose(){
      openIdx = null;
      tabs.forEach(function(t){ t.classList.remove('active'); });
      panels.forEach(function(p){ p.classList.remove('active'); });
      Object.keys(swipers).forEach(function(key){ destroySwiper(key); });
    }

    function bannerToggle(idx){
      if (openIdx === idx) bannerClose(); else bannerOpen(idx);
    }

    var pinned = false;
    var savedSlotH = null;

    function bannerSync(){
      var fixedSearch = document.querySelector('.th-hero-search-wrapper.is-scroll-fixed');
      var slot = root.closest('[id^="th-hero-cattabs-slot-"]');
      if (fixedSearch && fixedSearch.offsetHeight > 0) {
        if (!pinned) {
          pinned = true;
          if (savedSlotH === null) {
            savedSlotH = slot ? slot.offsetHeight : 0;
            if (slot) slot.style.minHeight = savedSlotH + 'px';
          }
          bar.classList.add('cat-bar-fixed');
          bar.style.top = Math.round(fixedSearch.getBoundingClientRect().bottom + 8) + 'px';
          bar.style.width = root.offsetWidth + 'px';
        } else {
          bar.style.top = Math.round(fixedSearch.getBoundingClientRect().bottom + 8) + 'px';
        }
      } else if (pinned) {
        pinned = false;
        bar.classList.remove('cat-bar-fixed');
        bar.style.top = '';
        bar.style.width = '';
        if (savedSlotH !== null) {
          if (slot) slot.style.minHeight = '';
          savedSlotH = null;
        }
      }
    }

    function setupBannerMode(){
      bannerClose();

      tabs.forEach(function(tab){
        var idx = parseInt(tab.getAttribute('data-tab-index'), 10);
        tab.addEventListener('click', function(){ bannerToggle(idx); });
        tab.addEventListener('mouseenter', function(){
          if (Date.now() - catLastTouch < 800) return;
          if (openIdx === idx) return;
          clearTimeout(hideTimer);
          bannerOpen(idx);
        });
        tab.addEventListener('mouseleave', function(){ clearTimeout(hideTimer); });
      });

      root.addEventListener('mouseleave', function(){
        if (openIdx === null) return;
        clearTimeout(hideTimer);
        hideTimer = setTimeout(bannerClose, 180);
      });
      root.addEventListener('mouseenter', function(){ clearTimeout(hideTimer); });

      document.addEventListener('click', function(e){
        if (!root.contains(e.target)) bannerClose();
      });

      var raf = null;
      window.addEventListener('scroll', function(){
        if (raf) return;
        raf = requestAnimationFrame(function(){ raf = null; bannerSync(); });
      }, { passive: true });
      window.addEventListener('resize', bannerSync);
      bannerSync();
    }

    /* Always classic mode (same as homepage): click to switch tabs,
       no hover open, no sticky bar - on collection pages too. */
    function boot(){
      root.classList.remove('cat-banner-mode');
      wireClassic();
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
  })();
</script>

