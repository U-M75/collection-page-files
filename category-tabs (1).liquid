      overflow: visible !important;
      -webkit-overflow-scrolling: auto;
      scroll-snap-type: none !important;
      gap: 0;
      padding-bottom: 0 !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
      scrollbar-width: none;
    }
    #sid-{{ section.id }} .product-grid-list::-webkit-scrollbar{
      display: none;
    }

    /* Slide width is set by Swiper itself. flex: 0 0 auto prevents the
       old CSS flex-basis from conflicting with Swiper's measured width. */
    #sid-{{ section.id }} .product-grid-list .column{
      flex: 0 0 auto;
      scroll-snap-align: none;
    }

    /* PRODUCTS: full-bleed container + inner padding.
       Swiper takes the slide width from the container's CONTENT width, so on
       load exactly {{ section.settings.columns_mobile }} cards are fully
       visible (never a half card) and while scrolling the slides run to the
       screen edge. */
    #sid-{{ section.id }} .swiper-container-mobile{
      width: calc(100% + {{ section.settings.section_padding_left_mobile }}px + {{ section.settings.section_padding_right_mobile }}px);
      margin-left: calc(-1 * {{ section.settings.section_padding_left_mobile }}px);
      margin-right: calc(-1 * {{ section.settings.section_padding_right_mobile }}px);
      padding-left: {{ section.settings.tabs_edge_space | default: 20 }}px;
      padding-right: {{ section.settings.tabs_edge_space | default: 20 }}px;
      overflow: hidden;
      box-sizing: border-box;
