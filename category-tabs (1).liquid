    /* Every slide at full opacity - the old centre/active fade is gone */
    #sid-{{ section.id }} .swiper-slide {
      width: auto;
      height: auto;
      opacity: 1;
    }

    /* Fallback: if the Swiper CDN is blocked, keep the products visible
       and swipeable as a native scroll-snap carousel. */
    #sid-{{ section.id }} .swiper-container-mobile.cat-swiper-fallback{
      overflow: visible;
    }
    #sid-{{ section.id }} .swiper-container-mobile.cat-swiper-fallback .product-grid-list{
      overflow-x: auto !important;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory !important;
      scroll-behavior: smooth;
      gap: {{ section.settings.grid_gap_mb }}px;
    }
    #sid-{{ section.id }} .swiper-container-mobile.cat-swiper-fallback .product-grid-list .column{
      flex: 0 0 calc((100% - ({{ section.settings.grid_gap_mb }}px * ({{ section.settings.columns_mobile }} - 1))) / {{ section.settings.columns_mobile }});
      scroll-snap-align: start;
    }

    /* Collection cards - mobile - 2x2 grid */
    /* Full-bleed scroller + inner padding */
    #sid-{{ section.id }} .cat-collection-groups{
      display: flex;
      grid-template-columns: none;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: none;
      gap: 12px;
      width: calc(100% + {{ section.settings.section_padding_left_mobile }}px + {{ section.settings.section_padding_right_mobile }}px);
      margin-left: calc(-1 * {{ section.settings.section_padding_left_mobile }}px);
      margin-right: calc(-1 * {{ section.settings.section_padding_right_mobile }}px);
      padding-left: {{ section.settings.tabs_edge_space | default: 20 }}px;
      padding-right: {{ section.settings.tabs_edge_space | default: 20 }}px;
      box-sizing: border-box;
      scrollbar-width: none;
    }
    #sid-{{ section.id }} .cat-collection-groups::-webkit-scrollbar{
      display: none;
    }
    /* Each group = 2x2 grid of 4 collections */
    #sid-{{ section.id }} .cat-collection-group{
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: repeat(2, 1fr);
      flex: 0 0 calc((100% - 12px) / 1);
      scroll-snap-align: none;
      gap: 8px;
      min-height: 280px;
      width: 100%;
    }
    #sid-{{ section.id }} .cat-collection-group .cat-collection-card {
      flex: 0 0 auto;
      min-width: 0;
      width: 100%;
      aspect-ratio: 1 / 1;
      border-radius: 12px;
    }
    #sid-{{ section.id }} .cat-collection-card-image{
      aspect-ratio: 1 / 1;
      height: 100%;
      width: 100%;
    }
    #sid-{{ section.id }} .cat-collection-card-title{
      font-size: 16px;
      bottom: 14px;
      left: 12px;
      right: 12px;
    }

    /* Featured cards: one per view, same square look as the groups */
    #sid-{{ section.id }} .cat-collection-featured{
      flex: 0 0 calc((100% - 12px) / 1);
      scroll-snap-align: none;
      min-height: 280px;
      padding: 16px 18px 18px;
    }
    #sid-{{ section.id }} .cat-collection-featured-title{
      font-size: {{ section.settings.featured_title_size_mobile }}px;
    }
    #sid-{{ section.id }} .cat-collection-featured-caption{
      font-size: {{ section.settings.featured_caption_size_mobile }}px;
      margin-top: 8px;
    }

    /* Big collections row: MOBILE SLIDER - one big collection card at a
       time (the next card peeks at the edge), swipeable with snap,
       full-bleed exactly like the products carousel */
    #sid-{{ section.id }} .cat-big-row{
      display: flex;
      gap: 8px;
      margin-top: 20px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scroll-padding-left: {{ section.settings.tabs_edge_space | default: 20 }}px;
      width: calc(100% + {{ section.settings.section_padding_left_mobile }}px + {{ section.settings.section_padding_right_mobile }}px);
      margin-left: calc(-1 * {{ section.settings.section_padding_left_mobile }}px);
      margin-right: calc(-1 * {{ section.settings.section_padding_right_mobile }}px);
      padding-left: {{ section.settings.tabs_edge_space | default: 20 }}px;
      padding-right: {{ section.settings.tabs_edge_space | default: 20 }}px;
      box-sizing: border-box;
      scrollbar-width: none;
    }
    #sid-{{ section.id }} .cat-big-row::-webkit-scrollbar{
